# Makefile configuration variables

# See https://github.com/rstudio/rstudio/tags for versions.
RSTUDIO_SOURCE_TAG=v2024.12.1+563
# UBUNTU_IMAGE_TAG also needs to be set in Dockerfile
UBUNTU_IMAGE_TAG="focal-20250404"

# IMAGE is used to specify the linux distribution to use (focal, jammy, rhel8,
#  etc.).
IMAGE=focal

APP_NAME=rstudio-server
IMAGE_REPO=containers.renci.org/helxplatform
VERSION=v0.2.2

# These variables used when running the container.
CONTAINER_PORT=8787
HOST_PORT=8888
# ENTRYPOINT=
# ENTRYPOINT=/bin/bash
# ENTRYPOINT=/start.sh
# ENTRYPOINT=env
# UID=0
UID=1000
# UID=1000790020
GID=0
# HOST_MOUNT="-v $PWD/host:/host"
DOCKER_RUN_ENV_FILE=docker-run.env
